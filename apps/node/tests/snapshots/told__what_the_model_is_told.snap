    },
    {
      "description": "Archive a thread; its work is not stopped.",
      "properties": {
        "action": {
          "const": "archive",
          "type": "string"
        },
        "thread": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "thread"
      ],
      "type": "object"
    },
    {
      "description": "Restore an archived thread to the person's list.",
      "properties": {
        "action": {
          "const": "unarchive",
          "type": "string"
        },
        "thread": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "thread"
      ],
      "type": "object"
    },
    {
      "description": "Hide a thread until a future instant; its work is not stopped.",
      "properties": {
        "action": {
          "const": "snooze",
          "type": "string"
        },
        "thread": {
          "type": "string"
        },
        "until": {
          "description": "A future ISO timestamp with an explicit UTC offset, such as `2026-12-01T09:00:00+08:00` or `2026-12-01T01:00:00Z`.",
          "type": "string"
        }
      },
      "required": [
        "action",
        "thread",
        "until"
      ],
      "type": "object"
    },
    {
      "description": "End a thread's snooze without starting its work.",
      "properties": {
        "action": {
          "const": "unsnooze",
          "type": "string"
        },
        "thread": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "thread"
      ],
      "type": "object"
    }
  ]
}

=== tool write
Write a whole file, creating it and any missing directories. Returns how many lines were added and removed. To change part of a file, use edit.
--- parameters
{
  "properties": {
    "content": {
      "description": "The file's complete new contents.",
      "type": "string"
    },
    "path": {
      "description": "File: relative to the workspace, absolute, or starting with ~ for the home folder.",
      "type": "string"
    }
  },
  "required": [
    "path",
    "content"
  ],
  "type": "object"
}
