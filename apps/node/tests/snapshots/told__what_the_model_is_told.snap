          "description": "Read the conversation about this entry's id, as search gives it.",
          "type": [
            "string",
            "null"
          ]
        },
        "before": {
          "description": "Read the page before this entry's id, as a page's note gives it.",
          "type": [
            "string",
            "null"
          ]
        },
        "thread": {
          "description": "The thread's id.",
          "type": "string"
        }
      },
      "required": [
        "action",
        "thread"
      ],
      "type": "object"
    },
    {
      "description": "Create a thread in this folder with your model and mode; `message` is its first input.",
      "properties": {
        "action": {
          "const": "start",
          "type": "string"
        },
        "message": {
          "description": "Everything the new thread needs; it does not see this conversation.",
          "type": "string"
        },
        "report": {
          "default": false,
          "description": "Get a message when the turn that takes `message` ends.",
          "type": "boolean"
        },
        "title": {
          "description": "A short title, shown to the person.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "message"
      ],
      "type": "object"
    },
    {
      "description": "Send a thread a message; it takes it at its next step, or starts a turn with it.",
      "properties": {
        "action": {
          "const": "send",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "report": {
          "default": false,
          "description": "Get a message when the turn that takes `message` ends.",
          "type": "boolean"
        },
        "thread": {
          "description": "The thread's id.",
          "type": "string"
        }
      },
      "required": [
