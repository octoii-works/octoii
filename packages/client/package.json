{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@octoii-works/octoii-client",
	"version": "0.0.1",
	"private": true,
	"description": "Octoii's typed HTTP client, live watches, and React hooks",
	"homepage": "https://github.com/octoii-works/octoii/tree/main/packages/client#readme",
	"license": "MIT",
	"author": "Elian Yang (https://elianyang.com)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/octoii-works/octoii.git",
		"directory": "packages/client"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./react": "./src/react/index.ts"
	},
	"scripts": {
		"typecheck": "bun check",
		"test": "bun test --timeout=60000 --no-env-file --no-install ./test/unit",
		"test:against-node": "bun test --timeout=60000 --no-env-file --no-install ./test/node"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"react": "catalog:"
	},
	"peerDependencies": {
		"react": ">=19"
	}
}
